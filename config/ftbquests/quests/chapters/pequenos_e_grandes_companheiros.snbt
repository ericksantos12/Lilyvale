	quests: [
		{
			description: [
				"A rede do Naturalist recolhe criaturas pequenas, como borboletas, vaga-lumes e caracóis, sem machucar. Solte-as no jardim de casa."
				"A fauna de Lilyvale é para conviver: nenhuma página deste capítulo pede caça. A tarefa registra posse, sem consumir: troca e presente também valem."
			]
			hide_details_until_startable: false
			hide_text_until_complete: false
			icon: "naturalist:capture_net"
			id: "7A11100000000001"
