			x: 0.0d
			y: 0.0d
		}
		{
			description: [
				"Hamsters aparecem em campos e florestas. Sementes de trigo, beterraba ou abóbora conquistam a confiança deles."
				"Chegue perto e mire no animal até a tarefa registrar. Observar basta: nada de capturar, domar ou machucar."
			]
			hide_details_until_startable: false
			hide_text_until_complete: false
			icon: "minecraft:wheat_seeds"
