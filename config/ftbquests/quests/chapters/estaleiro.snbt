	order_index: 3
	quest_links: [ ]
	quests: [
		{
			description: [
				"Barcos de verdade nascem em terra firme. No aleki's Nifty Ships, o casco é desenhado no chão com andaimes de estaleiro e depois forrado de tábuas."
				"O andaime inclinado (Sloped Shipwright's Scaffolding) sai de seis andaimes comuns em escada na bancada e rende cinco. O barco a remo pede seis."
				"Escolha um lugar plano perto da água: o barco aparece onde o casco foi montado."
			]
			hide_details_until_startable: false
			hide_text_until_complete: false
			icon: "alekiships:watercraft_frame_angled"
			id: "7A20100000000001"
			rewards: [{
