		{
			dependencies: ["7A20100000000004"]
			description: [
				"Os cunhos (Cleat) são onde se amarram os cabos do barco, e são eles que transformam o casco pronto em um sloop em construção. O sloop pede quatro, um em cada canto marcado na planta."
				"A âncora (Anchor) entra perto do fim da obra e segura o barco parado contra o vento. Ela pede um bloco de ferro."
			]
			hide_details_until_startable: false
